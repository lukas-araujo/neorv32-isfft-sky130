set sdc_version 2.0

set_units -capacitance 1000fF
set_units -time 1000ps

# Set the current design
current_design asic_top

create_clock -name "clk_i" -period 20.0 -waveform {0.0 10.0} [get_ports clk_i]
set_load -pin_load 0.05 [get_ports uart0_txd_o]
set_false_path -from [get_ports rstn_i]
set_clock_gating_check -setup 0.0 
set_input_delay -clock [get_clocks clk_i] -add_delay 6.0 [get_ports uart0_rxd_i]
set_output_delay -clock [get_clocks clk_i] -add_delay 6.0 [get_ports uart0_txd_o]
set_input_transition -min 0.05 [get_ports uart0_rxd_i]
set_input_transition -max 0.5 [get_ports uart0_rxd_i]
set_ideal_net [get_nets clk_i]
set_ideal_net [get_nets rstn_i]
set_wire_load_mode "top"
set_dont_use true [get_lib_cells sky130_fd_sc_hd__tt_025C_1v80/sky130_fd_sc_hd__lpflow_bleeder_1]
